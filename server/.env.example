# Copy to .env for local development. On Railway these are set in the
# service's "Variables" tab instead (PORT is injected automatically).

# SQLite file. Defaults to ./data/odomap.db locally; on Railway it defaults to
# the attached volume (RAILWAY_VOLUME_MOUNT_PATH), and the server refuses to
# start there without one so accounts can't be silently wiped on a redeploy.
# DATABASE_PATH=./data/odomap.db

PORT=3000
NODE_ENV=development
